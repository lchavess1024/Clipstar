{
  "name": "clipstar",
  "version": "1.2.0",
  "private": true,
  "description": "A local-first Chrome extension for reusable text clips.",
  "type": "module",
  "scripts": {
    "check": "node scripts/validate.mjs",
    "test": "node --test tests/unit/*.test.js",
